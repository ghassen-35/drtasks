# انسخ هذا الملف إلى .env أو اضبط المتغيرات في بيئة التشغيل (كلها اختيارية)
PORT=3000
# APP_URL=https://office.example.org        # الرابط العام (يُستخدم في روابط البريد)
# DATA_DIR=./data                           # مكان قاعدة البيانات والملفات والنسخ الاحتياطية
# TZ_NAME=Asia/Riyadh
# COOKIE_SECURE=1                           # فعّله عند التشغيل خلف HTTPS
# TRUST_PROXY=1                             # عدد طبقات البروكسي الموثوقة أمام الخادم
# PBKDF2_ITERATIONS=100000                  # تكلفة تجزئة كلمات المرور (الحد الأقصى على Cloudflare 100000)

# الحسابات الأولية (تُستخدم عند أول تشغيل فقط؛ وإلا تُولَّد كلمات مرور عشوائية)
# OWNER_USERNAME=owner
# OWNER_NAME=رجل الأعمال
# OWNER_PASSWORD=
# MANAGER_USERNAME=manager
# MANAGER_NAME=مدير المكتب
# MANAGER_PASSWORD=

# البريد الإلكتروني: off (افتراضي) | resend (HTTP، يعمل على Cloudflare) | smtp | file (Node: يحفظ الرسائل في data/outbox دون إرسال)
# RESEND_API_KEY=
EMAIL_MODE=off
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="مكتب رجل الأعمال <office@example.org>"

# إشعارات Push (تُولَّد مفاتيح VAPID تلقائيًا في data/vapid.json إن لم تُحدد)
# VAPID_SUBJECT=mailto:office@example.org

# واتساب — معطل. يتطلب WhatsApp Business Platform الرسمية وقالبًا معتمدًا
WHATSAPP_ENABLED=0
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=office_notification
