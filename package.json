{
  "name": "office-platform",
  "version": "1.0.0",
  "description": "منصة إدارة مكتب رجل الأعمال والتواصل مع مدير المكتب",
  "main": "src/node/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/node/server.js",
    "demo:seed": "node --disable-warning=ExperimentalWarning scripts/demo.js seed",
    "demo:clear": "node --disable-warning=ExperimentalWarning scripts/demo.js clear",
    "backup": "node --disable-warning=ExperimentalWarning -e \"const c=require('./src/config');c.set(process.env);console.log(require('./src/node/sqlite').init(c.get('DATA_DIR','data')).backup('manual'))\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.js",
    "test:unit": "node --disable-warning=ExperimentalWarning tests/unit.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:cf",
    "test:cf": "E2E_TARGET=cf node --disable-warning=ExperimentalWarning tests/e2e.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.16",
    "nodemailer": "^10.2.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "http_ece": "^1.2.1",
    "playwright": "1.63.0",
    "wrangler": "^4.156.0"
  }
}
